# LimeSurvey on Railway — environment variables.
# Only DB_PASSWORD and ADMIN_PASSWORD appear on the one-click deploy form
# (as generated values); everything else is baked into the Docker images
# or derived at boot. See README.md "Configuration" for the full list.

# App service (limesurvey)
DB_HOST=${{postgres.RAILWAY_PRIVATE_DOMAIN}}
DB_PASSWORD=${{postgres.POSTGRES_PASSWORD}}
ADMIN_PASSWORD=${{secret(32)}}

# Companion service (postgres)
POSTGRES_PASSWORD=${{secret(32)}}
